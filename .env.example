# ===================== Cadena Digital S5 — configuración =====================
# Copie a .env (permisos 600). Nunca suba .env ni la carpeta llaves/ a git.

# worker = sella bloques (llave privada) | api = consulta interna | panel = dashboard público | todo = todo (desarrollo)
# En Windows también puede usar: npm run start:worker | start:api | start:panel
ROL=todo

# --- MongoDB del S5 (usuario de SOLO LECTURA; ver mongo/crear-usuario-s5.js) ---
S5_MONGO_URI=mongodb://s5_cadena_lector:CAMBIAR@servidor-s5:27017/?authSource=admin&replicaSet=rs0&tls=true
S5_DB=S5
S5_COLLECTION=denuncias
# objectId | string
S5_ID_TYPE=objectId
# Campos de primer nivel que NO forman parte del contenido protegido (separados por comas)
S5_EXCLUDE_FIELDS=
# flujo = change streams (requiere replica set) | sondeo = conciliación periódica
S5_MODO=flujo
# updateLookup | whenAvailable | required  (required exige changeStreamPreAndPostImages, MongoDB 6+)
S5_FULL_DOCUMENT=updateLookup
S5_SONDEO_MS=300000

# --- MongoDB PROPIO de la cadena (otro servidor; ver mongo/crear-roles-ledger.js) ---
# worker: usuario s5_cadena_worker · api: usuario s5_cadena_api
LEDGER_MONGO_URI=mongodb://s5_cadena_worker:CAMBIAR@ledger-db:27017/?authSource=admin&replicaSet=rs0
LEDGER_DB=s5_cadena

# --- Llaves (npm run llaves) ---
LLAVE_FIRMA_PATH=./llaves/firma-privada.pem
LLAVES_CONFIANZA_DIR=./llaves/confianza
# Opcional y recomendado: secreto (>=32 caracteres) para HMAC de las huellas
# openssl rand -base64 48 > llaves/pepper.txt && chmod 600 llaves/pepper.txt
HASH_PEPPER_PATH=

# --- Bloques ---
BLOQUE_MAX_ENTRADAS=500
BLOQUE_INTERVALO_MS=60000
# Sellar bloques vacíos sirve como "latido" verificable de que el servicio estaba activo
BLOQUE_SELLAR_VACIOS=false
AUDITORIA_INTERVALO_MS=21600000
# Verificación integral periódica de la cadena (el panel público muestra su resultado)
VERIFICACION_INTERVALO_MS=3600000

# --- API de verificación ---
API_HOST=0.0.0.0
API_PORT=8443
TLS_CERT_PATH=./tls/servidor.crt
TLS_KEY_PATH=./tls/servidor.key
# Si se define, exige certificado de cliente firmado por esta CA (mTLS)
TLS_CA_PATH=
# SHA-256 de las llaves de API autorizadas (npm run llave-api), separadas por comas
API_KEYS_SHA256=
# IPs autorizadas (backend del S5, OIC, auditores). Vacío = cualquiera (no recomendado)
IPS_PERMITIDAS=
# Cuota por llave de API (peticiones/minuto)
API_LIMITE_POR_MINUTO=6000
# IP del proxy inverso, si existe (nunca "true")
TRUST_PROXY=
PERMITIR_HTTP_INSEGURO=false

# --- Panel de monitoreo (ROL=panel) ---
# Usuario del ledger para el panel: s5_cadena_panel (ver mongo/crear-roles-ledger.js)
# S5_MONGO_URI puede quedar VACÍO para el panel: entonces no compara documentos en vivo.
PANEL_HOST=192.168.1.77
PANEL_PORT=8444
PANEL_TLS_CERT_PATH=./tls/panel.crt
PANEL_TLS_KEY_PATH=./tls/panel.key
# Secreto (>=32 caracteres) para firmar sesiones:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))" > llaves/panel-secreto.txt
PANEL_SECRETO_SESION_PATH=./llaves/panel-secreto.txt
# Minutos de inactividad y horas máximas de una sesión de Contraloría/Administración
PANEL_SESION_MINUTOS=30
PANEL_SESION_MAX_HORAS=8
# IPs de la red institucional desde las que se permite el acceso restringido (vacío = cualquiera)
PANEL_IPS_PRIVILEGIADAS=
# Consultas por minuto por IP en el panel público, e intentos fallidos de inicio de sesión por IP (15 min)
PANEL_LIMITE_PUBLICO_POR_MINUTO=120
PANEL_INTENTOS_FALLIDOS_POR_IP=10
# Antigüedad máxima (ms) de un cambio sin sellar antes de marcar "en observación"
PANEL_MAX_ANTIGUEDAD_PENDIENTE_MS=900000
# IP del proxy inverso del panel, si existe (nunca "true")
PANEL_TRUST_PROXY=
# Usuario s5_cadena_gestor, solo para scripts/usuario-panel.js
LEDGER_GESTOR_MONGO_URI=
